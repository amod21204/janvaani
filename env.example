# Server-side AI keys used by the civic complaint workflow.
# You can use either Gemini or OpenAI. If both are set, Gemini is tried first.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Optional server config
PORT=3000
HOST=0.0.0.0

# Optional SMTP config for real OTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=JAN-VAANI <no-reply@example.com>

# MySQL config for civic complaint modules
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=janvaani

# Frontend (Vercel) API base URL
VITE_API_URL=https://your-backend-url
